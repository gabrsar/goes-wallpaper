#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SAVE_DIR="$SCRIPT_DIR/.goes-wallpaper-data"

mkdir -p "$SAVE_DIR"

SAT=$(cat "$HOME/.config/goes-sat")
SECTOR=$(cat "$HOME/.config/goes-sector")

# SAT contains "G16", "G18", "G19" etc. from the install script.
# NOAA's CDN uses "GOES16", "GOES18", "GOES19" — expand the prefix.
SAT_FULL=$(echo "$SAT" | sed 's/^G/GOES/')

PAGE_FILE="$SAVE_DIR/sector_page.html"

# Preferred resolution for wallpaper (width x height)
PREFERRED_RES="3600x2160"

curl -s "https://www.star.nesdis.noaa.gov/GOES/sector.php?sat=${SAT}&sector=${SECTOR}" > "$PAGE_FILE"

# NOAA now uses full CDN URLs like:
#   https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/ssa/GEOCOLOR/20260481450_GOES19-ABI-ssa-GEOCOLOR-3600x2160.jpg
# We look for GEOCOLOR images at the preferred resolution, then pick the latest one.
HIGHEST=$(grep -oE "href='https://cdn\.star\.nesdis\.noaa\.gov/${SAT_FULL}/ABI/SECTOR/${SECTOR}/GEOCOLOR/[^']+${PREFERRED_RES}\.jpg'" "$PAGE_FILE" \
  | sed "s/^href='\(.*\)'$/\1/" \
  | sort -r \
  | head -n1)

# If preferred resolution not found, try any GEOCOLOR resolution (pick the largest available)
if [ -z "$HIGHEST" ]; then
  HIGHEST=$(grep -oE "href='https://cdn\.star\.nesdis\.noaa\.gov/${SAT_FULL}/ABI/SECTOR/${SECTOR}/GEOCOLOR/[^']+\.jpg'" "$PAGE_FILE" \
    | sed "s/^href='\(.*\)'$/\1/" \
    | sort -r \
    | head -n1)
fi

if [ -n "$HIGHEST" ]; then
  FILE_NAME="$SAVE_DIR/${SAT}_${SECTOR}_$(date +%Y%m%d%H%M%S).jpg"
  curl -s "$HIGHEST" -o "$FILE_NAME"

  # Verify the download produced a real file (not empty or error page)
  if [ -s "$FILE_NAME" ]; then
    echo "$FILE_NAME"
  else
    echo "Download failed or empty file for ${SAT} sector ${SECTOR}." >&2
    rm -f "$FILE_NAME"
    exit 1
  fi
else
  echo "No GEOCOLOR image found for ${SAT} sector ${SECTOR}." >&2
  exit 1
fi
